# =====================================================================
# 智能旅行助手 · 后端环境变量模板
# 用法：复制本文件为 .env，填入真实密钥后启动后端。
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# =====================================================================

# 大模型配置（OpenAI 兼容接口，可换成任意兼容服务）
# OPENAI_API_KEY: 必填，模型服务密钥
OPENAI_API_KEY=
# OPENAI_BASE_URL: 模型服务地址（国内镜像 / 代理需按实际情况填写）
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL: 使用的模型名称
OPENAI_MODEL=gpt-4

# 高德地图配置（行程规划、POI 检索、天气、动线计算均依赖此密钥）
# AMAP_API_KEY: 必填，高德开放平台「Web 服务」密钥
#   申请地址: https://console.amap.com/
AMAP_API_KEY=

# Unsplash 图片服务（可选，未配置时自动回退到内置分类图库）
# UNSPLASH_ACCESS_KEY / UNSPLASH_SECRET_KEY: 图片搜索服务密钥，均可留空
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO